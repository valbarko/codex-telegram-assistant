TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Optional comma-separated IDs that may only transcribe voice and audio. Their content is not persisted.
TELEGRAM_TRANSCRIPTION_ONLY_USER_IDS=

ASSISTANT_WORKSPACE=
ASSISTANT_DATA_DIR=
# Readable Markdown backup for diary and story voice modes.
WRITING_ARCHIVE_DIR=
# Local MemSearch CLI. Defaults to ~/.local/bin/memsearch.
MEMSEARCH_BIN=

# Incrementally import private, non-shared Apple Notes into local memory.
# With one full-access Telegram user, the owner ID is inferred automatically.
APPLE_NOTES_IMPORT_ENABLED=false
APPLE_NOTES_IMPORT_OWNER_ID=
APPLE_NOTES_IMPORT_INTERVAL_MS=86400000
# Protected notes remain excluded unless explicitly opted in and unlocked in Notes.
APPLE_NOTES_IMPORT_PROTECTED=false

# Optional self-hosted Hindsight knowledge layer. It uses a dedicated Codex login
# backed by the same ChatGPT Plus/Pro account, not an OpenAI Platform API key.
HINDSIGHT_ENABLED=false
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
HINDSIGHT_REFLECT_BUDGET=low
HINDSIGHT_TIMEOUT_MS=45000
HINDSIGHT_LIVE_BATCH_SIZE=10
HINDSIGHT_LIVE_FLUSH_MS=5000
# Set to 1 after the first successful model download for deterministic restarts.
HINDSIGHT_HF_OFFLINE=0
# Absolute host directory containing a dedicated auth.json created with:
# CODEX_HOME=/absolute/path codex login --device-auth
HINDSIGHT_CODEX_HOME=

# Example: {"trenervkarmane":"ТРЕНЕР","clients":"КЛИЕНТЫ","money":"ДЕНЬГИ"}
PROJECT_ALIASES_JSON={}

# Morning weather. Defaults to Moscow.
WEATHER_LOCATION=Москва
WEATHER_LATITUDE=55.7558
WEATHER_LONGITUDE=37.6173

ASSISTANT_DEFAULT_PROFILE=default
CODEX_MODEL=
MAX_UPLOAD_BYTES=20971520
SHOW_TURN_USAGE=false

# Optional local MLX Whisper environment.
WHISPER_PYTHON=python3
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Optional summaries for standalone YouTube, RuTube, and VK Video links.
MEDIA_DOWNLOADER_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
# Six hours by default. Live streams are not supported.
MEDIA_SUMMARY_MAX_DURATION_SECONDS=21600
# Optional authentication for platforms that request a browser check. Set only one.
# Browser access is explicit because it lets yt-dlp read that browser's cookies.
MEDIA_COOKIES_FROM_BROWSER=
MEDIA_COOKIES_FILE=

# Name of a local Shortcut whose Clock action creates an alarm from Shortcut Input.
ALARM_SHORTCUT_NAME=Codex Alarm
