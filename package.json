{
  "name": "codex-telegram-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Telegram client and personal assistant for Codex app-server",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && scripts/build-calendar-reader.sh",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "migrate": "tsx src/migrate-user-data.ts",
    "style:build": "node scripts/build-style-corpus.mjs",
    "style:index": "memsearch index .private/style-corpus/posts --collection cta_style_valentin --provider onnx --description 'Private writing corpus for Valentin Barko' --force",
    "style:search": "memsearch search --top-k 8 --collection cta_style_valentin --provider onnx",
    "style:search:personal": "memsearch search --top-k 8 --collection cta_style_valentin --provider onnx --source-prefix \"$PWD/.private/style-corpus/posts/barko-pro-zhizn\"",
    "style:search:expert": "memsearch search --top-k 8 --collection cta_style_valentin --provider onnx --source-prefix \"$PWD/.private/style-corpus/posts/v-svoem-tele\"",
    "apple-notes:import": "tsx src/apple-notes-import.ts",
    "memory:import": "tsx src/archive-import-cli.ts",
    "profile:import": "tsx src/profile-import-cli.ts",
    "hindsight:up": "docker compose --env-file .env -f infra/hindsight/compose.yaml up -d",
    "hindsight:down": "docker compose --env-file .env -f infra/hindsight/compose.yaml down",
    "hindsight:status": "docker compose --env-file .env -f infra/hindsight/compose.yaml ps",
    "hindsight:logs": "docker compose --env-file .env -f infra/hindsight/compose.yaml logs --tail=100 hindsight",
    "hindsight:smoke": "tsx src/hindsight-smoke.ts",
    "hindsight:backfill": "tsx src/hindsight-backfill.ts",
    "article:backfill": "tsx src/article-idea-cli.ts",
    "telegram:connect": "tsx src/telegram-reader-cli.ts connect",
    "telegram:connect-qr": "tsx src/telegram-reader-cli.ts connect-qr",
    "telegram:status": "tsx src/telegram-reader-cli.ts status",
    "telegram:reader-status": "tsx src/telegram-reader-cli.ts status",
    "telegram:channels": "tsx src/telegram-reader-cli.ts channels",
    "telegram:allow": "tsx src/telegram-reader-cli.ts allow",
    "telegram:read": "tsx src/telegram-reader-cli.ts read",
    "telegram:access": "tsx src/telegram-reader-cli.ts access",
    "telegram:post": "tsx src/telegram-reader-cli.ts post",
    "telegram:edit-post": "tsx src/telegram-reader-cli.ts edit-post",
    "telegram:export-post": "tsx src/telegram-reader-cli.ts export-post",
    "telegram:scheduled": "tsx src/telegram-reader-cli.ts scheduled",
    "telegram:sync-publications": "tsx src/telegram-reader-cli.ts sync-publications",
    "telegram:join": "tsx src/telegram-reader-cli.ts join",
    "telegram:folder": "tsx src/telegram-reader-cli.ts folder",
    "telegram:folder-status": "tsx src/telegram-reader-cli.ts folder-status",
    "telegram:folder-add": "tsx src/telegram-reader-cli.ts folder-add",
    "telegram:folder-rename": "tsx src/telegram-reader-cli.ts folder-rename"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "@vectorize-io/hindsight-client": "0.8.5",
    "better-sqlite3": "12.11.1",
    "grammy": "1.38.2",
    "prebuilt-tdlib": "^0.1008066.0",
    "qrcode": "^1.5.4",
    "tdl": "^8.1.0",
    "typograf": "7.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
